&control
    title= 'hfo'
    calculation='scf'
    restart_mode = 'restart'
    prefix='hfo'
    pseudo_dir='./'
    tstress=.true.
    tprnfor=.true.
    tefield = .true.
    dipfield = .true.
    etot_conv_thr=1.D-7,
    forc_conv_thr=1.D-6,
    verbosity='high'
    wf_collect=.true.
    nstep=600
 /
 &system
    nosym = True
    input_dft='PBESOL'
    edir=3
    emaxpos= 0.90
    eopreg = 0.05
    eamp = 0.0001
    ibrav=0
    nat= 25
    ntyp=5
    ecutwfc = 50.0,
    ecutrho     = 400.0
    occupations='smearing'
    smearing = 'fd'
    degauss = 0.01
 /
 &electrons
    diagonalization='david'
    conv_thr =  1.0d-8
    mixing_beta = 0.3
    electron_maxstep = 200
    mixing_mode = 'local-TF'
    startingwfc = 'file'
    startingpot = 'file'
 /
&IONS
  upscale           = 100.D0,
/
&CELL
  cell_dynamics     = 'bfgs'
/
